table 'dim_date'
	description: "Conformed date dimension used for campaign, lead, conversion, and target analysis."
	lineageTag: dim_date

	column date_day
		dataType: dateTime
		summarizeBy: none

	column year
		dataType: int64
		summarizeBy: none

	column quarter
		dataType: string
		summarizeBy: none

	column month_number
		dataType: int64
		summarizeBy: none

	column month_name
		dataType: string
		summarizeBy: none

	column week_of_year
		dataType: int64
		summarizeBy: none

table 'mart_data_product_scorecard'
	description: "BI data product operating scorecard for reliability, quality, attribution, action ownership, planning readiness, and executive confidence."
	lineageTag: mart_data_product_scorecard

	column scorecard_domain
		dataType: string
		summarizeBy: none

	column owner_team
		dataType: string
		summarizeBy: none

	column service_level_indicator
		dataType: string
		summarizeBy: none

	column current_value
		dataType: string
		summarizeBy: none

	column target_value
		dataType: string
		summarizeBy: none

	column score
		dataType: decimal
		summarizeBy: none

	column score_status
		dataType: string
		summarizeBy: none

	column risk_count
		dataType: int64
		summarizeBy: none

	column evidence
		dataType: string
		summarizeBy: none

	column next_action
		dataType: string
		summarizeBy: none

	column dashboard_surface
		dataType: string
		summarizeBy: none

	measure 'Average Data Product Score' = AVERAGE('mart_data_product_scorecard'[score])
		formatString: "0.0"
		displayFolder: "Governance"

	measure 'At Risk Domains' = CALCULATE(COUNTROWS('mart_data_product_scorecard'), 'mart_data_product_scorecard'[score_status] = "at_risk")
		formatString: "#,0"
		displayFolder: "Governance"

	measure 'Governance Risk Count' = SUM('mart_data_product_scorecard'[risk_count])
		formatString: "#,0"
		displayFolder: "Governance"

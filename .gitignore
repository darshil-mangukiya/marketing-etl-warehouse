# Terraform local working data, inputs, plans and state. Keep the provider lock
# file tracked so validation uses a reproducible provider version.
terraform/.terraform/
terraform/terraform.tfvars
terraform/*.auto.tfvars
terraform/*.tfplan
terraform/tfplan
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log

# Terraform artifacts are sensitive regardless of their directory.
*.tfstate
*.tfstate.*
*.tfplan
tfplan
*.tfvars
!*.tfvars.example

# Keep lightweight release evidence in GitHub while excluding heavy raw lake/source data.
!data/exports/
!data/exports/*.csv
!data/exports/*.json
# Nested handoff/analyst exports are reproducible; already tracked evidence remains tracked.
data/exports/*/
!catalog/generated/
!catalog/generated/*.csv
!catalog/generated/*.json
!catalog/generated/*.md
!metadata/generated/
!metadata/generated/*.json
!metadata/generated/*.jsonl
!metadata/generated/*.md

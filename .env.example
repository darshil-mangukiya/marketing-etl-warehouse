# Local demo defaults only. Copy this file to .env for local development.
# Override every credential for non-local use, and never commit real .env files.

PROJECT_NAME=marketing-etl-platform
ENVIRONMENT=local
DATA_LAKE_ROOT=./data/lake
QUALITY_REPORT_DIR=./data/quality_reports
EXPORT_DIR=./data/exports
LOG_DIR=./data/logs

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=marketing_warehouse
POSTGRES_USER=marketing
POSTGRES_PASSWORD=marketing

AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

DBT_PROFILES_DIR=/opt/dbt
DBT_TARGET=dev

MOCK_API_TOKEN=local-dev-token
SOURCE_MANIFEST_PATH=./data_sources/generated/manifest.json

# Optional GCP/cloud mode. Local mode ignores these values.
EXECUTION_MODE=local
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCS_BUCKET=
BIGQUERY_RAW_DATASET=marketing_raw
BIGQUERY_STAGING_DATASET=marketing_staging
BIGQUERY_WAREHOUSE_DATASET=marketing_warehouse
BIGQUERY_MART_DATASET=marketing_mart
BIGQUERY_AUTH_METHOD=oauth
BIGQUERY_MAXIMUM_BYTES_BILLED=104857600
GOOGLE_APPLICATION_CREDENTIALS=
SECRET_PROVIDER=environment

# Vendor connectors. Never commit actual values.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_ACCESS_TOKEN=
